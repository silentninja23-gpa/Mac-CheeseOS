<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
  <defs>
    <!-- Background Gradient -->
    <radialGradient id="bgGrad" cx="50%" cy="50%" r="70%">
      <stop offset="0%" stop-color="#1e1b18" />
      <stop offset="100%" stop-color="#0c0a09" />
    </radialGradient>

    <!-- Cheese Gradient -->
    <linearGradient id="cheeseGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fbbf24" />
      <stop offset="50%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#d97706" />
    </linearGradient>

    <!-- Cheese Glow -->
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="15" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>

    <style>
      .brand-title {
        font-family: 'Inter', -apple-system, sans-serif;
        font-weight: 700;
        font-size: 32px;
        fill: #ffffff;
        letter-spacing: -0.5px;
      }
      .brand-subtitle {
        font-family: 'Inter', -apple-system, sans-serif;
        font-weight: 500;
        font-size: 14px;
        fill: #fbbf24;
        letter-spacing: 2px;
        text-transform: uppercase;
      }
    </style>
  </defs>

  <!-- Background Canvas -->
  <rect width="500" height="500" rx="90" fill="url(#bgGrad)" />

  <!-- Outer Glow behind Logo -->
  <circle cx="250" cy="200" r="90" fill="#f59e0b" opacity="0.15" filter="url(#glow)" />

  <!-- Logo Group -->
  <g transform="translate(0, -10)">
    <!-- Apple Leaf (Mac Vibe) -->
    <path d="M 268 95 C 285 75 280 50 255 45 C 240 42 225 55 220 70 C 235 70 255 80 268 95 Z" fill="#10b981" opacity="0.9" />

    <!-- Main Cheese-Wedge Apple Body -->
    <path d="M 250 115 
             C 210 115, 175 145, 175 190 
             C 175 240, 210 275, 250 315 
             C 290 275, 325 240, 325 190 
             C 325 145, 290 115, 250 115 Z" 
          fill="url(#cheeseGrad)" 
          stroke="#fef08a" 
          stroke-width="3" 
          stroke-linejoin="round"
          filter="url(#glow)" />

    <!-- Cheese Holes (Macintosh bite / Swiss cheese style) -->
    <!-- Top Left Hole -->
    <circle cx="215" cy="170" r="14" fill="#b45309" opacity="0.6" />
    <circle cx="213" cy="168" r="14" fill="#d97706" opacity="0.4" />

    <!-- Bottom Right Hole -->
    <circle cx="285" cy="235" r="20" fill="#b45309" opacity="0.6" />
    <circle cx="282" cy="232" r="20" fill="#d97706" opacity="0.4" />

    <!-- Center Small Hole -->
    <circle cx="240" cy="240" r="10" fill="#b45309" opacity="0.6" />

    <!-- Top Right Small Hole -->
    <circle cx="280" cy="155" r="8" fill="#b45309" opacity="0.5" />
  </g>

  <!-- Typography: Mac & CheeseOS -->
  <text x="250" y="380" text-anchor="middle" class="brand-title">Mac &amp; CheeseOS</text>
  <text x="250" y="410" text-anchor="middle" class="brand-subtitle">Web Operating System</text>
</svg>
